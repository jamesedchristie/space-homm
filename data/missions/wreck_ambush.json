        {
          "label": "Pull the recorder core",
          "check": {
            "skill": "tech",
            "difficulty": 3
          },
          "text": "The core comes out clean. The last minutes of the freighter's flight include a raider hail and a map of their camps.",
          "effects": [
            {
              "type": "reward",
              "xp": 40,
              "research": 35,
              "intel": 1
            }
          ],
          "fail_text": "The recorder's emergency beacon pings, and every raider on the moon knows where you are.",
