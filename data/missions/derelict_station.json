        {
          "label": "Slice the logs quietly",
          "check": {
            "skill": "tech",
            "difficulty": 3
          },
          "text": "You ghost past the daemon. The logs show the raiders came for the data core, and where they posted guards.",
          "effects": [
            {
              "type": "reward",
              "xp": 45
            }
          ],
          "fail_text": "The daemon catches the intrusion. Somewhere aft, an alarm starts to wail.",
